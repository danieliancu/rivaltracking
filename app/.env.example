# Copy to .env (or export in your shell) and adjust. All values are read via
# os.environ in config/settings/. Local development works with no .env at all
# (config.settings.local uses SQLite and a dev SECRET_KEY).

# DJANGO_SETTINGS_MODULE=config.settings.local
# SECRET_KEY=change-me

# --- Production / demo (config.settings.production or .demo) ---------------
# ALLOWED_HOSTS=rivaltracking.com,www.rivaltracking.com
# CSRF_TRUSTED_ORIGINS=https://rivaltracking.com

# PostgreSQL (required in production; optional in demo — demo falls back to
# SQLite when DB_HOST is unset):
# DB_NAME=rivaltracking
# DB_USER=rivaltracking
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Email (password-reset links). Defaults to the console backend.
# DEFAULT_FROM_EMAIL=RivalTracking <no-reply@rivaltracking.com>

# One-click "Enter the demo" sign-in (password-less; no demo password exists).
# Disable in real production. DEMO_EMAIL selects which seeded user it signs in.
# DEMO_LOGIN_ENABLED=1
# DEMO_EMAIL=demo@rivaltracking.com

# --- Phase 3: processing engine (Celery / Redis / scraping / AI) -----------
# REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=0            # 0 = use real workers (prod/demo)
# CELERY_WORKER_CONCURRENCY=4
# SCANNING_LIVE=1                        # 1 = scrape real sites (prod/demo)
# HTTP_TIMEOUT=15
# SCAN_MAX_PAGES=200
# SCRAPER_CONCURRENCY=4
# SCRAPER_PER_DOMAIN_RPS=1
# LISTING_MISSES_BEFORE_REMOVED=2
# RAW_CAPTURE_RETENTION_DAYS=30
# BROWSER_ENABLED=0                      # 1 needs the Playwright worker image
# BROWSER_CONCURRENCY=1

# AI provider (default "stub" = deterministic, no key needed)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_MAX_ANALYSES_PER_SCAN=30

# Email (real SMTP for alert delivery; console backend by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=1
