# Copy to .env (or export in your shell) and adjust. All values are read via
# os.environ in config/settings/. Local development works with no .env at all.

# DJANGO_SETTINGS_MODULE=config.settings.local
# SECRET_KEY=change-me

# Production only (config.settings.production):
# ALLOWED_HOSTS=rivaltracking.com
# DB_NAME=rivaltracking
# DB_USER=rivaltracking
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
