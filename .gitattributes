# Normalize line endings: store LF in the repo, check out native.
* text=auto

# Keep these as LF everywhere.
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
